# House of Nucci — environment
#
# Copy to .env.local for development. Nothing here is required to run the site: the
# canonical production domain is the default, and every provider is optional (§73).

# The origin this build serves from. Canonical URLs, the sitemap, OpenGraph tags and
# social cards all resolve against it.
#   production  https://houseofnucci.art   (the default; no need to set it)
#   staging     https://<preview-host>
#   local       http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# `production` enables indexing and makes the build fail while any demo placeholder record
# remains in the collection. Anything else is treated as development.
COLLECTION_MODE=development

# Server-side only. Never expose a provider key to the browser (§72).
# Enrichment and verification; the museum runs without it.
# OPENSEA_API_KEY=
